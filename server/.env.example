# =============================================================================
# Mini CRM - Environment Variables Configuration (.env.example)
# Tạo bản sao tệp này thành .env trong thư mục server/ trên môi trường chạy (VPS hoặc Local)
# =============================================================================

# 1. Cổng lắng nghe của Backend Server (Mặc định: 5000)
PORT=5000

# 2. Môi trường ứng dụng ('production' khi chạy VPS thực tế, 'development' khi chạy ở máy cá nhân)
NODE_ENV=production

# 3. Thông tin cấu hình MySQL Database (Dùng cho setup.sh cài đặt VPS & khởi tạo DB)
DB_NAME="minicrm"
DB_USER="minicrm_user"
DB_PASS="ChangeMeStrongPass123!"

# Chuỗi kết nối MySQL Database 8.x (Dùng cho Prisma ORM)
# Cú pháp: mysql://<DB_USER>:<DB_PASS>@<HOST>:<PORT>/<DB_NAME>
DATABASE_URL="mysql://minicrm_user:ChangeMeStrongPass123!@localhost:3306/minicrm"

# 4. Chuỗi kết nối Redis Server (Dùng cho BullMQ Worker & Async Queue)
# Cú pháp: redis://localhost:6379 hoặc redis://:password@localhost:6379
REDIS_URL="redis://localhost:6379"

# 5. Khóa bí mật dùng mã hóa JWT Token (BẮT BỘC đổi thành chuỗi ngẫu nhiên bảo mật trên VPS)
# Gợi ý tạo chuỗi bí mật trên VPS: openssl rand -base64 32
JWT_SECRET="minicrm_super_secret_jwt_key_2026_change_me"

# 6. Danh sách URL Frontend được phép truy cập API (CORS Policy)
# Hỗ trợ 1 tên miền, nhiều tên miền phân cách bởi dấu phẩy, hoặc '*' cho tất cả
CLIENT_URL="https://yourdomain.com,http://localhost:5173"

# 7. (Tùy chọn) Token mặc định kết nối Smax.ai API
# SMAX_API_TOKEN="your_smax_api_token_here"
