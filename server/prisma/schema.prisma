  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)

  business Business @relation(fields: [bizId], references: [id], onDelete: Cascade)
  lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
