  @@index([bizId, entityType, entityId], map: "idx_audit_biz_entity")
  @@index([bizId, actorId], map: "idx_audit_biz_actor")
  @@index([bizId, createdAt], map: "idx_audit_biz_created")
  @@map("audit_logs")
}

model LeadCreationLog {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  bizId             BigInt   @map("biz_id") @db.UnsignedBigInt
