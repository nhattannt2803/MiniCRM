}

model Task {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  bizId       BigInt    @map("biz_id") @db.UnsignedBigInt
  title       String    @db.VarChar(200)
  description String?   @db.Text
  priority    String    @default("MEDIUM") @db.VarChar(20)
  status      String    @default("TODO") @db.VarChar(30)
  assignedTo  BigInt?   @map("assigned_to") @db.UnsignedBigInt
  createdBy   BigInt?   @map("created_by") @db.UnsignedBigInt
  dueAt       DateTime  @map("due_at") @db.DateTime(3)
  completedAt DateTime? @map("completed_at") @db.DateTime(3)
  relatedType String    @map("related_type") @db.VarChar(30)
  relatedId   BigInt    @map("related_id") @db.UnsignedBigInt
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  business    Business  @relation(fields: [bizId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("TaskAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  creator     User?     @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([bizId, assignedTo, status, dueAt], map: "idx_tasks_biz_assigned_status_due")
  @@index([bizId, relatedType, relatedId], map: "idx_tasks_biz_related")
  @@index([bizId, dueAt, status], map: "idx_tasks_biz_due_status")
  @@map("tasks")
}

model Notification {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  bizId      BigInt    @map("biz_id") @db.UnsignedBigInt
  userId     BigInt    @map("user_id") @db.UnsignedBigInt
  type       String    @db.VarChar(50)
  title      String    @db.VarChar(200)
  message    String    @db.Text
  entityType String?   @map("entity_type") @db.VarChar(50)
  entityId   BigInt?   @map("entity_id") @db.UnsignedBigInt
  readAt     DateTime? @map("read_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  business   Business  @relation(fields: [bizId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bizId, userId, readAt], map: "idx_notif_biz_user_read")
  @@index([bizId, createdAt], map: "idx_notif_biz_created")
  @@map("notifications")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  bizId      BigInt   @map("biz_id") @db.UnsignedBigInt
