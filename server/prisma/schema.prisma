  sentAt         DateTime     @default(now()) @map("sent_at") @db.DateTime(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId], map: "idx_msg_conv")
  @@map("messages")
}

model LeadProduct {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  leadId    BigInt   @map("lead_id") @db.UnsignedBigInt
  productId BigInt   @map("product_id") @db.UnsignedBigInt
  isPrimary Boolean  @default(false) @map("is_primary")
  notes     String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([leadId], map: "idx_lp_lead")
  @@index([productId], map: "idx_lp_product")
  @@map("lead_products")
}

model LeadAd {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  leadId       BigInt   @map("lead_id") @db.UnsignedBigInt
  adId         String   @map("ad_id") @db.VarChar(191)
  adName       String?  @map("ad_name") @db.VarChar(255)
  adsetId      String?  @map("adset_id") @db.VarChar(191)
  adsetName    String?  @map("adset_name") @db.VarChar(255)
