datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// MULTI-TENANT: Business (Doanh Nghiệp / Tổ Chức dùng SaaS)
// =============================================================================

model Business {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name      String   @db.VarChar(150)
  slug      String   @unique @db.VarChar(50)
  logo      String?  @db.VarChar(500)
  taxCode   String?  @map("tax_code") @db.VarChar(50)
  email     String?  @db.VarChar(191)
  phone     String?  @db.VarChar(30)
  address   String?  @db.Text
  status    String   @default("ACTIVE") @db.VarChar(30)
  plan      String   @default("FREE") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  members         BusinessMember[]
  roles           Role[]
  campaigns       Campaign[]
  companies       Company[]
  contacts        Contact[]
  customers       Customer[]
  leads           Lead[]
  pipelines       Pipeline[]
  products        Product[]
  opportunities   Opportunity[]
  automations     Automation[]
  activities      Activity[]
  tasks           Task[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  outboxEvents    OutboxEvent[]
  quotes          Quote[]
  conversations   Conversation[]
  systemSettings  SystemSetting[]
  apiKeys         ApiKey[]
  productMappings ProductMapping[]
  leadCreationLogs LeadCreationLog[]
  courses         Course[]

  @@index([status], map: "idx_biz_status")
  @@map("businesses")
}

// =============================================================================
// MULTI-TENANT: BusinessMember (Thay thế UserRole — Role scoped per Biz)
// =============================================================================

model BusinessMember {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  businessId BigInt   @map("business_id") @db.UnsignedBigInt
  userId     BigInt   @map("user_id") @db.UnsignedBigInt
  roleId     BigInt   @map("role_id") @db.UnsignedBigInt
  isDefault  Boolean  @default(false) @map("is_default")
  isActive   Boolean  @default(true) @map("is_active")
  joinedAt   DateTime @default(now()) @map("joined_at") @db.DateTime(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([businessId, userId], map: "uk_biz_user")
  @@index([userId, isDefault], map: "idx_bm_user_default")
  @@map("business_members")
}

// =============================================================================
// IAM: Roles & Users
// =============================================================================

model Role {
  id          BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  bizId       BigInt           @map("biz_id") @db.UnsignedBigInt
  name        String           @db.VarChar(50)
  code        String           @db.VarChar(50)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  business    Business         @relation(fields: [bizId], references: [id], onDelete: Cascade)
  members     BusinessMember[]

  @@unique([bizId, code], map: "uk_role_biz_code")
  @@index([bizId], map: "idx_roles_biz")
  @@map("roles")
}

model User {
  id                BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  email             String                   @unique @db.VarChar(191)
  passwordHash      String                   @map("password_hash") @db.VarChar(255)
  firstName         String                   @map("first_name") @db.VarChar(100)
  lastName          String                   @map("last_name") @db.VarChar(100)
  phone             String?                  @db.VarChar(30)
  isActive          Boolean                  @default(true) @map("is_active")
  isSuperAdmin      Boolean                  @default(false) @map("is_super_admin")
  createdAt         DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime                 @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt         DateTime?                @map("deleted_at") @db.DateTime(3)
  memberships       BusinessMember[]
  campaigns         Campaign[]
  companies         Company[]
  contacts          Contact[]
  customers         Customer[]
  leads             Lead[]                   @relation("LeadOwner")
  opportunities     Opportunity[]            @relation("OpportunityOwner")
  stageHistories    OpportunityStageHistory[] @relation("StageHistoryChangedBy")
  quotes            Quote[]                  @relation("QuoteCreatedBy")
  activitiesOwned   Activity[]               @relation("ActivityOwner")
  activitiesCreated Activity[]               @relation("ActivityCreator")
  tasksAssigned     Task[]                   @relation("TaskAssignee")
  tasksCreated      Task[]                   @relation("TaskCreator")
  notifications     Notification[]
  auditLogs         AuditLog[]
  automationsCreated Automation[]
  createdApiKeys    ApiKey[]
  leadCreationLogs  LeadCreationLog[]

  @@index([email], map: "idx_users_email")
  @@index([isActive], map: "idx_users_is_active")
  @@map("users")
}

// =============================================================================
// CRM Core: Campaign, Company, Contact, Customer, Lead
// =============================================================================

model Campaign {
  id              BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  bizId           BigInt        @map("biz_id") @db.UnsignedBigInt
  name            String        @db.VarChar(150)
  code            String        @db.VarChar(50)
  type            String        @db.VarChar(50)
  status          String        @default("ACTIVE") @db.VarChar(30)
  budget          Decimal       @default(0.00) @db.Decimal(15, 2)
  actualCost      Decimal       @default(0.00) @map("actual_cost") @db.Decimal(15, 2)
  expectedRevenue Decimal       @default(0.00) @map("expected_revenue") @db.Decimal(15, 2)
  startDate       DateTime?     @map("start_date") @db.Date
  endDate         DateTime?     @map("end_date") @db.Date
  ownerId         BigInt?       @map("owner_id") @db.UnsignedBigInt
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt       DateTime?     @map("deleted_at") @db.DateTime(3)
  business        Business      @relation(fields: [bizId], references: [id], onDelete: Cascade)
  owner           User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  leads           Lead[]
  opportunities   Opportunity[]

  @@unique([bizId, code], map: "uk_campaign_biz_code")
  @@index([bizId, status], map: "idx_campaigns_biz_status")
  @@index([bizId, type], map: "idx_campaigns_biz_type")
  @@map("campaigns")
}

model Company {
  id            BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  bizId         BigInt        @map("biz_id") @db.UnsignedBigInt
  name          String        @db.VarChar(200)
  taxCode       String?       @map("tax_code") @db.VarChar(50)
  email         String?       @db.VarChar(191)
  phone         String?       @db.VarChar(30)
  website       String?       @db.VarChar(255)
  address       String?       @db.Text
  ownerId       BigInt?       @map("owner_id") @db.UnsignedBigInt
  status        String        @default("PROSPECT") @db.VarChar(30)
  isCustomer    Boolean       @default(false) @map("is_customer")
  createdAt     DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt     DateTime?     @map("deleted_at") @db.DateTime(3)
  business      Business      @relation(fields: [bizId], references: [id], onDelete: Cascade)
  owner         User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  contacts      Contact[]
  customers     Customer[]
  leads         Lead[]
  opportunities Opportunity[]
  quotes        Quote[]

  @@index([bizId, ownerId], map: "idx_companies_biz_owner")
  @@index([bizId, name], map: "idx_companies_biz_name")
  @@index([bizId, taxCode], map: "idx_companies_biz_tax_code")
  @@index([bizId, isCustomer], map: "idx_companies_biz_is_customer")
  @@map("companies")
}

model Contact {
  id            BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  bizId         BigInt        @map("biz_id") @db.UnsignedBigInt
  companyId     BigInt?       @map("company_id") @db.UnsignedBigInt
  firstName     String        @map("first_name") @db.VarChar(100)
  lastName      String        @map("last_name") @db.VarChar(100)
  email         String?       @db.VarChar(191)
  phone         String?       @db.VarChar(30)
  position      String?       @db.VarChar(100)
  department    String?       @db.VarChar(100)
  isPrimary     Boolean       @default(false) @map("is_primary")
  ownerId       BigInt?       @map("owner_id") @db.UnsignedBigInt
  isCustomer    Boolean       @default(false) @map("is_customer")
  createdAt     DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt     DateTime?     @map("deleted_at") @db.DateTime(3)
  business      Business      @relation(fields: [bizId], references: [id], onDelete: Cascade)
  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner         User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  customers     Customer[]
  leads         Lead[]
  opportunities Opportunity[]
  quotes        Quote[]

  @@index([bizId, companyId], map: "idx_contacts_biz_company")
  @@index([bizId, ownerId], map: "idx_contacts_biz_owner")
  @@index([bizId, email], map: "idx_contacts_biz_email")
  @@index([bizId, phone], map: "idx_contacts_biz_phone")
  @@map("contacts")
}

model Customer {
  id            BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  bizId         BigInt             @map("biz_id") @db.UnsignedBigInt
  customerCode  String             @map("customer_code") @db.VarChar(50)
  entityType    String             @map("entity_type") @db.VarChar(20)
  companyId     BigInt?            @map("company_id") @db.UnsignedBigInt
  contactId     BigInt?            @map("contact_id") @db.UnsignedBigInt
  ownerId       BigInt?            @map("owner_id") @db.UnsignedBigInt
  status        String             @default("ACTIVE") @db.VarChar(30)
  customerSince DateTime           @default(now()) @map("customer_since") @db.DateTime(3)
  lifetimeValue Decimal            @default(0.00) @map("lifetime_value") @db.Decimal(15, 2)
  createdAt     DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt     DateTime?          @map("deleted_at") @db.DateTime(3)
  business      Business           @relation(fields: [bizId], references: [id], onDelete: Cascade)
  company       Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact       Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner         User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  opportunities Opportunity[]
  leadsConverted Lead[]            @relation("ConvertedCustomer")
  leads         Lead[]             @relation("CustomerLeads")
  identities    CustomerIdentity[]
  conversations Conversation[]

  @@unique([bizId, customerCode], map: "uk_customer_biz_code")
  @@index([bizId, companyId], map: "idx_customers_biz_company")
  @@index([bizId, contactId], map: "idx_customers_biz_contact")
  @@index([bizId, ownerId], map: "idx_customers_biz_owner")
  @@index([bizId, status], map: "idx_customers_biz_status")
  @@map("customers")
}

model Lead {
  id                       BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  bizId                    BigInt       @map("biz_id") @db.UnsignedBigInt
  companyId                BigInt?      @map("company_id") @db.UnsignedBigInt
  contactId                BigInt?      @map("contact_id") @db.UnsignedBigInt
  customerId               BigInt?      @map("customer_id") @db.UnsignedBigInt
  campaignId               BigInt?      @map("campaign_id") @db.UnsignedBigInt
  ownerId                  BigInt?      @map("owner_id") @db.UnsignedBigInt
  source                   String       @db.VarChar(50)
  status                   String       @default("NEW") @db.VarChar(30)
  rating                   String       @default("WARM") @db.VarChar(20)
  identityResolutionStatus String       @default("MATCHED") @map("identity_resolution_status") @db.VarChar(30)
  firstName                String       @map("first_name") @db.VarChar(100)
  lastName                 String       @map("last_name") @db.VarChar(100)
  email                    String?      @db.VarChar(191)
  phone                    String?      @db.VarChar(30)
  companyName              String?      @map("company_name") @db.VarChar(200)
  jobTitle                 String?      @map("job_title") @db.VarChar(100)
  notes                    String?      @db.Text
  smaxBizSlug              String?      @map("smax_biz_slug") @db.VarChar(100)
  fbPageId                 String?      @map("fb_page_id") @db.VarChar(50)
  fbPageName               String?      @map("fb_page_name") @db.VarChar(200)
  convertedOpportunityId   BigInt?      @map("converted_opportunity_id") @db.UnsignedBigInt
  convertedCustomerId      BigInt?      @map("converted_customer_id") @db.UnsignedBigInt
  convertedAt              DateTime?    @map("converted_at") @db.DateTime(3)
  receivedAt               DateTime?    @map("received_at") @db.DateTime(3)
  createdAt                DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime     @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt                DateTime?    @map("deleted_at") @db.DateTime(3)
  business                 Business     @relation(fields: [bizId], references: [id], onDelete: Cascade)
  company                  Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact                  Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  customer                 Customer?    @relation("CustomerLeads", fields: [customerId], references: [id], onDelete: SetNull)
  campaign                 Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  owner                    User?        @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  convertedOpportunity     Opportunity? @relation("ConvertedOpportunity", fields: [convertedOpportunityId], references: [id], onDelete: SetNull)
  convertedCustomer        Customer?    @relation("ConvertedCustomer", fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  opportunities            Opportunity[] @relation("LeadSource")
  conversations            Conversation[]
  products                 LeadProduct[]
  ads                      LeadAd[]
  leadCreationLogs         LeadCreationLog[]

  @@index([bizId, status], map: "idx_leads_biz_status")
  @@index([bizId, ownerId], map: "idx_leads_biz_owner")
  @@index([bizId, source], map: "idx_leads_biz_source")
  @@index([bizId, createdAt], map: "idx_leads_biz_created_at")
  @@index([bizId, receivedAt], map: "idx_leads_biz_received_at")
  @@index([bizId, email], map: "idx_leads_biz_email")
  @@index([bizId, campaignId], map: "idx_leads_biz_campaign")
  @@index([bizId, customerId], map: "idx_leads_biz_customer")
  @@index([bizId, fbPageId], map: "idx_leads_biz_fb_page")
  @@map("leads")
}

// =============================================================================
// Sales Pipeline & Deal Management
// =============================================================================

model Pipeline {
  id            BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  bizId         BigInt          @map("biz_id") @db.UnsignedBigInt
  name          String          @db.VarChar(100)
  isDefault     Boolean         @default(false) @map("is_default")
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  business      Business        @relation(fields: [bizId], references: [id], onDelete: Cascade)
  stages        PipelineStage[]
  opportunities Opportunity[]

  @@index([bizId, isActive], map: "idx_pipelines_biz_active")
  @@map("pipelines")
}

model PipelineStage {
  id             BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  pipelineId     BigInt                    @map("pipeline_id") @db.UnsignedBigInt
  name           String                    @db.VarChar(100)
  code           String                    @db.VarChar(50)
  orderNo        Int                       @default(1) @map("order_no")
  probability    Decimal                   @default(0.00) @db.Decimal(5, 2)
  isWon          Boolean                   @default(false) @map("is_won")
  isLost         Boolean                   @default(false) @map("is_lost")
  allowLeadMerge Boolean                   @default(true) @map("allow_lead_merge")
  stageCategory  String                    @default("OPEN") @map("stage_category")
  isActive       Boolean                   @default(true) @map("is_active")
  createdAt      DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime                  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  pipeline       Pipeline                  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities  Opportunity[]
  historyFrom    OpportunityStageHistory[] @relation("FromStage")
  historyTo      OpportunityStageHistory[] @relation("ToStage")

  @@unique([pipelineId, code], map: "uk_pipeline_stage_code")
  @@index([pipelineId, orderNo], map: "idx_ps_pipeline_order")
  @@map("pipeline_stages")
}

model Opportunity {
  id                BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  bizId             BigInt                    @map("biz_id") @db.UnsignedBigInt
  companyId         BigInt?                   @map("company_id") @db.UnsignedBigInt
  contactId         BigInt?                   @map("contact_id") @db.UnsignedBigInt
  customerId        BigInt?                   @map("customer_id") @db.UnsignedBigInt
  leadId            BigInt?                   @map("lead_id") @db.UnsignedBigInt
  campaignId        BigInt?                   @map("campaign_id") @db.UnsignedBigInt
  ownerId           BigInt?                   @map("owner_id") @db.UnsignedBigInt
  pipelineId        BigInt                    @map("pipeline_id") @db.UnsignedBigInt
  stageId           BigInt                    @map("stage_id") @db.UnsignedBigInt
  name              String                    @db.VarChar(200)
  amount            Decimal                   @default(0.00) @db.Decimal(15, 2)
  probability       Decimal                   @default(0.00) @db.Decimal(5, 2)
  expectedCloseDate DateTime?                 @map("expected_close_date") @db.Date
  source            String?                   @db.VarChar(50)
  description       String?                   @db.Text
  status            String                    @default("OPEN") @db.VarChar(30)
  lostReason        String?                   @map("lost_reason") @db.VarChar(255)
  wonAt             DateTime?                 @map("won_at") @db.DateTime(3)
  lostAt            DateTime?                 @map("lost_at") @db.DateTime(3)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime                  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt         DateTime?                 @map("deleted_at") @db.DateTime(3)
  business          Business                  @relation(fields: [bizId], references: [id], onDelete: Cascade)
  company           Company?                  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact           Contact?                  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  customer          Customer?                 @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead              Lead?                     @relation("LeadSource", fields: [leadId], references: [id], onDelete: SetNull)
  campaign          Campaign?                 @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  owner             User?                     @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  pipeline          Pipeline                  @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage             PipelineStage             @relation(fields: [stageId], references: [id], onDelete: Restrict)
  stageHistories    OpportunityStageHistory[]
  products          OpportunityProduct[]
  quotes            Quote[]
  leadsConverted    Lead[]                    @relation("ConvertedOpportunity")

  @@index([bizId, stageId], map: "idx_opp_biz_stage_id")
  @@index([bizId, ownerId], map: "idx_opp_biz_owner_id")
  @@index([bizId, status], map: "idx_opp_biz_status")
  @@index([bizId, expectedCloseDate], map: "idx_opp_biz_expected_close")
  @@index([bizId, companyId], map: "idx_opp_biz_company")
  @@index([bizId, customerId], map: "idx_opp_biz_customer")
  @@index([bizId, campaignId], map: "idx_opp_biz_campaign")
  @@map("opportunities")
}

model OpportunityStageHistory {
  id                BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  opportunityId     BigInt         @map("opportunity_id") @db.UnsignedBigInt
  fromStageId       BigInt?        @map("from_stage_id") @db.UnsignedBigInt
  toStageId         BigInt         @map("to_stage_id") @db.UnsignedBigInt
  changedBy         BigInt?        @map("changed_by") @db.UnsignedBigInt
  changedAt         DateTime       @default(now()) @map("changed_at") @db.DateTime(3)
  durationInSeconds BigInt?        @map("duration_in_seconds") @db.UnsignedBigInt
  opportunity       Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStage         PipelineStage? @relation("FromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage           PipelineStage  @relation("ToStage", fields: [toStageId], references: [id], onDelete: Restrict)
  user              User?          @relation("StageHistoryChangedBy", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([opportunityId, changedAt], map: "idx_osh_opp_changed")
  @@map("opportunity_stage_histories")
}

// =============================================================================
// Products, Quotes
// =============================================================================

model Product {
  id                  BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  bizId               BigInt               @map("biz_id") @db.UnsignedBigInt
  name                String               @db.VarChar(200)
  code                String               @db.VarChar(50)
  type                String               @default("PRODUCT") @db.VarChar(30)
  description         String?              @db.Text
  unitPrice           Decimal              @default(0.00) @map("unit_price") @db.Decimal(15, 2)
  currency            String               @default("VND") @db.VarChar(3)
  isActive            Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt           DateTime?            @map("deleted_at") @db.DateTime(3)
  business            Business             @relation(fields: [bizId], references: [id], onDelete: Cascade)
  opportunityProducts OpportunityProduct[]
  quoteItems          QuoteItem[]
  leadProducts        LeadProduct[]
  productMappings     ProductMapping[]

  @@unique([bizId, code], map: "uk_product_biz_code")
  @@index([bizId, isActive], map: "idx_products_biz_active")
  @@map("products")
}

model OpportunityProduct {
  id             BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  opportunityId  BigInt      @map("opportunity_id") @db.UnsignedBigInt
  productId      BigInt      @map("product_id") @db.UnsignedBigInt
  quantity       Int         @default(1)
  unitPrice      Decimal     @default(0.00) @map("unit_price") @db.Decimal(15, 2)
  discountAmount Decimal     @default(0.00) @map("discount_amount") @db.Decimal(15, 2)
  totalPrice     Decimal     @default(0.00) @map("total_price") @db.Decimal(15, 2)
  notes          String?     @db.VarChar(255)
  createdAt      DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  product        Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([opportunityId], map: "idx_op_opp_id")
  @@map("opportunity_products")
}

model Quote {
  id             BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  bizId          BigInt      @map("biz_id") @db.UnsignedBigInt
  opportunityId  BigInt      @map("opportunity_id") @db.UnsignedBigInt
  quoteNumber    String      @map("quote_number") @db.VarChar(50)
  version        Int         @default(1)
  companyId      BigInt?     @map("company_id") @db.UnsignedBigInt
  contactId      BigInt?     @map("contact_id") @db.UnsignedBigInt
  subtotal       Decimal     @default(0.00) @db.Decimal(15, 2)
  discountAmount Decimal     @default(0.00) @map("discount_amount") @db.Decimal(15, 2)
  taxAmount      Decimal     @default(0.00) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount    Decimal     @default(0.00) @map("total_amount") @db.Decimal(15, 2)
  currency       String      @default("VND") @db.VarChar(3)
  status         String      @default("DRAFT") @db.VarChar(30)
  validUntil     DateTime?   @map("valid_until") @db.Date
  createdBy      BigInt?     @map("created_by") @db.UnsignedBigInt
  createdAt      DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime    @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt      DateTime?   @map("deleted_at") @db.DateTime(3)
  business       Business    @relation(fields: [bizId], references: [id], onDelete: Cascade)
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  company        Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact        Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  creator        User?       @relation("QuoteCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  items          QuoteItem[]

  @@unique([bizId, quoteNumber], map: "uk_quote_biz_number")
  @@index([bizId, opportunityId], map: "idx_quotes_biz_opp")
  @@index([bizId, status], map: "idx_quotes_biz_status")
  @@map("quotes")
}

model QuoteItem {
