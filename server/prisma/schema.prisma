// =============================================================================
// Automation Engine & Outbox
// =============================================================================

model OutboxEvent {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  bizId        BigInt    @map("biz_id") @db.UnsignedBigInt
  eventId      String    @unique @map("event_id") @db.VarChar(64)
  eventType    String    @map("event_type") @db.VarChar(100)
  entityType   String    @map("entity_type") @db.VarChar(50)
  entityId     BigInt    @map("entity_id") @db.UnsignedBigInt
  payload      Json
  status       String    @default("PENDING") @db.VarChar(20)
  retryCount   Int       @default(0) @map("retry_count")
  errorMessage String?   @map("error_message") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  processedAt  DateTime? @map("processed_at") @db.DateTime(3)
  business     Business  @relation(fields: [bizId], references: [id], onDelete: Cascade)

  @@index([bizId, status, createdAt], map: "idx_outbox_biz_status_created")
  @@map("outbox_events")
}

model Automation {
  id          BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  bizId       BigInt                @map("biz_id") @db.UnsignedBigInt
  name        String                @db.VarChar(150)
  description String?               @db.Text
  isActive    Boolean               @default(true) @map("is_active")
  triggerType String                @map("trigger_type") @db.VarChar(50)
  priority    Int                   @default(10)
  createdBy   BigInt?               @map("created_by") @db.UnsignedBigInt
  createdAt   DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime              @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime?             @map("deleted_at") @db.DateTime(3)
  business    Business              @relation(fields: [bizId], references: [id], onDelete: Cascade)
  creator     User?                 @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  triggers    AutomationTrigger[]
  conditions  AutomationCondition[]
  actions     AutomationAction[]
  executions  AutomationExecution[]

  @@index([bizId, isActive, triggerType], map: "idx_auto_biz_active_trigger")
  @@map("automations")
}

model AutomationTrigger {
  id           BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  automationId BigInt                @map("automation_id") @db.UnsignedBigInt
  triggerEvent String                @map("trigger_event") @db.VarChar(50)
  entityType   String                @map("entity_type") @db.VarChar(50)
  config       Json?
  createdAt    DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  automation   Automation            @relation(fields: [automationId], references: [id], onDelete: Cascade)
  executions   AutomationExecution[]

  @@index([triggerEvent, entityType], map: "idx_at_event_entity")
  @@map("automation_triggers")
}

model AutomationCondition {
  id            BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  automationId  BigInt                @map("automation_id") @db.UnsignedBigInt
  parentId      BigInt?               @map("parent_id") @db.UnsignedBigInt
  logicOperator String                @default("AND") @map("logic_operator") @db.VarChar(10)
  field         String?               @db.VarChar(100)
  operator      String?               @db.VarChar(20)
  value         Json?
  orderNo       Int                   @default(1) @map("order_no")
  createdAt     DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  automation    Automation            @relation(fields: [automationId], references: [id], onDelete: Cascade)
  parent        AutomationCondition?  @relation("ConditionHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children      AutomationCondition[] @relation("ConditionHierarchy")

  @@index([automationId], map: "idx_ac_automation")
  @@map("automation_conditions")
}

model AutomationAction {
  id           BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  automationId BigInt     @map("automation_id") @db.UnsignedBigInt
  actionType   String     @map("action_type") @db.VarChar(50)
  config       Json
  stepOrder    Int        @default(1) @map("step_order")
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, stepOrder], map: "idx_aa_automation_step")
  @@map("automation_actions")
}

model AutomationExecution {
  id             BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  automationId   BigInt                   @map("automation_id") @db.UnsignedBigInt
  triggerId      BigInt?                  @map("trigger_id") @db.UnsignedBigInt
  eventId        String                   @map("event_id") @db.VarChar(64)
  entityType     String                   @map("entity_type") @db.VarChar(50)
  entityId       BigInt                   @map("entity_id") @db.UnsignedBigInt
  status         String                   @default("PENDING") @db.VarChar(20)
  idempotencyKey String                   @unique @map("idempotency_key") @db.VarChar(191)
  retryCount     Int                      @default(0) @map("retry_count")
  maxRetries     Int                      @default(3) @map("max_retries")
  errorMessage   String?                  @map("error_message") @db.Text
  startedAt      DateTime?                @map("started_at") @db.DateTime(3)
  completedAt    DateTime?                @map("completed_at") @db.DateTime(3)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime                 @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  automation     Automation               @relation(fields: [automationId], references: [id], onDelete: Cascade)
  trigger        AutomationTrigger?       @relation(fields: [triggerId], references: [id], onDelete: SetNull)
  executionLogs  AutomationExecutionLog[]

  @@index([status], map: "idx_ae_status")
  @@index([entityType, entityId], map: "idx_ae_entity")
  @@index([eventId], map: "idx_ae_event")
  @@map("automation_executions")
}

model AutomationExecutionLog {
  id            BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  executionId   BigInt              @map("execution_id") @db.UnsignedBigInt
  stepNo        Int                 @map("step_no")
  actionType    String              @map("action_type") @db.VarChar(50)
  status        String              @db.VarChar(20)
  inputPayload  Json?               @map("input_payload")
  outputPayload Json?               @map("output_payload")
  errorMessage  String?             @map("error_message") @db.Text
  executedAt    DateTime            @default(now()) @map("executed_at") @db.DateTime(3)
  execution     AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId], map: "idx_ael_execution")
  @@map("automation_execution_logs")
}

// =============================================================================
// Customer Identity, Conversations, Messages
// =============================================================================

model CustomerIdentity {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  customerId    BigInt   @map("customer_id") @db.UnsignedBigInt
  type          String   @db.VarChar(30)
  identityValue String   @map("identity_value") @db.VarChar(191)
  isVerified    Boolean  @default(false) @map("is_verified")
  status        String   @default("ACTIVE") @db.VarChar(30)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, type, identityValue], name: "customerId_type_identityValue", map: "uk_customer_identity_type_value")
  @@index([type, identityValue], map: "idx_identity_type_value")
  @@index([customerId], map: "idx_identity_customer")
  @@map("customer_identities")
}

model Conversation {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  bizId           BigInt    @map("biz_id") @db.UnsignedBigInt
  customerId      BigInt?   @map("customer_id") @db.UnsignedBigInt
  leadId          BigInt?   @map("lead_id") @db.UnsignedBigInt
  channelType     String    @map("channel_type") @db.VarChar(30)
  channelThreadId String?   @map("channel_thread_id") @db.VarChar(191)
  smaxBizSlug     String?   @map("smax_biz_slug") @db.VarChar(100)
  status          String    @default("OPEN") @db.VarChar(30)
  lastMessageAt   DateTime? @map("last_message_at") @db.DateTime(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  business        Business  @relation(fields: [bizId], references: [id], onDelete: Cascade)
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead            Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages        Message[]

  @@index([bizId, customerId], map: "idx_conv_biz_customer")
  @@index([bizId, leadId], map: "idx_conv_biz_lead")
  @@map("conversations")
}

model Message {
  id             BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  conversationId BigInt       @map("conversation_id") @db.UnsignedBigInt
  senderType     String       @map("sender_type") @db.VarChar(20)
  senderId       String?      @map("sender_id") @db.VarChar(100)
  content        String       @db.Text
