// =============================================================================
// System Settings (scoped per Biz)
// =============================================================================

model SystemSetting {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  bizId       BigInt   @map("biz_id") @db.UnsignedBigInt
  key         String   @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(255)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)
  business    Business @relation(fields: [bizId], references: [id], onDelete: Cascade)

  @@unique([bizId, key], map: "uk_setting_biz_key")
  @@map("system_settings")
}

// =============================================================================
// API Keys (scoped per Biz for External Integrations & Webhooks)
// =============================================================================

model ApiKey {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  bizId       BigInt    @map("biz_id") @db.UnsignedBigInt
  name        String    @db.VarChar(100)
  key         String    @unique @db.VarChar(100)
  secret      String?   @db.VarChar(255)
  status      String    @default("ACTIVE") @db.VarChar(30)
  lastUsedAt  DateTime? @map("last_used_at") @db.DateTime(3)
  expiresAt   DateTime? @map("expires_at") @db.DateTime(3)
  createdById BigInt?   @map("created_by_id") @db.UnsignedBigInt
